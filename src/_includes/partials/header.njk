<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header" id="siteHeader">
  <div class="container header-inner">
    <a class="logo" href="{{ '/' | url }}">Dr. Biswajit <span>Mohapatra</span></a>

    <nav class="nav-links" aria-label="Primary">
      {%- for item in nav %}
      <a href="{{ item.url | url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>

    <div class="header-actions">
      {% include "partials/linkedin-badge.njk" %}
      <button class="burger" id="burgerBtn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobilePanel">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-panel" id="mobilePanel" aria-label="Primary (compact)">
    {%- for item in nav %}
    <a href="{{ item.url | url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
    <div class="mobile-socials">
      {% include "partials/linkedin-badge.njk" %}
    </div>
  </nav>
</header>
